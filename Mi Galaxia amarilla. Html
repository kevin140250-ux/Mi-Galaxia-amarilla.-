<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para Wildanyelis 🌻</title>
    <style>
        /* Estilos base */
        body {
            margin: 0;
            padding: 0;
            background: radial-gradient(circle, #0d1b2a 0%, #010811 100%);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: 'Arial', sans-serif;
            perspective: 1000px;
        }

        /* Estrellas parpadeantes */
        .star {
            position: absolute;
            background-color: white;
            border-radius: 50%;
            animation: blink 2s infinite ease-in-out;
            z-index: 1;
        }

        @keyframes blink {
            0%, 100% { opacity: 0.2; }
            50% { opacity: 1; }
        }

        /* Pétalos cayendo */
        .falling-petal {
            position: absolute;
            background: linear-gradient(to top, #ffd000, #ffea00);
            border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
            opacity: 0.8;
            z-index: 2;
            animation: fall linear infinite;
        }

        @keyframes fall {
            0% {
                transform: translateY(-20px) rotate(0deg);
                opacity: 0;
            }
            10% { opacity: 0.8; }
            90% { opacity: 0.8; }
            100% {
                transform: translateY(105vh) rotate(360deg);
                opacity: 0;
            }
        }

        /* Interfaz de la Carta Inicial */
        .envelope-wrapper {
            position: absolute;
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: opacity 1s ease, transform 1s ease;
        }

        .envelope {
            width: 200px;
            height: 140px;
            background: #e63946;
            position: relative;
            border-radius: 0 0 10px 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            cursor: pointer;
            transition: transform 0.3s;
        }

        .envelope:hover {
            transform: scale(1.05);
        }

        /* Solapa del sobre */
        .envelope::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            border-left: 100px solid transparent;
            border-right: 100px solid transparent;
            border-top: 80px solid #d62828;
            transform-origin: top;
            transition: transform 0.5s ease;
        }

        /* Corazón/Sello para abrir */
        .heart {
            position: absolute;
            top: 50px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 2rem;
            color: #ffb703;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: translateX(-50%) scale(1); }
            50% { transform: translateX(-50%) scale(1.2); }
        }

        .envelope-text {
            color: white;
            margin-top: 20px;
            font-size: 1.2rem;
            text-shadow: 0 2px 5px rgba(0,0,0,0.5);
            font-weight: bold;
        }

        /* Ocultar la carta al abrir */
        .envelope-wrapper.open {
            opacity: 0;
            transform: scale(0.5);
            pointer-events: none;
        }

        /* Contenedor principal de la flor (Oculto al inicio) */
        .flower-container {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            animation: float 4s ease-in-out infinite;
            opacity: 0;
            transform: scale(0.8);
            transition: opacity 1.5s ease 0.8s, transform 1.5s ease 0.8s;
            z-index: 10;
        }

        .flower-container.show {
            opacity: 1;
            transform: scale(1);
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }

        /* Centro de la flor */
        .center {
            width: 80px;
            height: 80px;
            background: radial-gradient(circle, #5c3d05 0%, #3a2202 100%);
            border-radius: 50%;
            position: relative;
            z-index: 10;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
        }

        /* Pétalos amarillos de la flor fija */
        .petal {
            position: absolute;
            width: 45px;
            height: 110px;
            background: linear-gradient(to top, #ffd000, #ffea00);
            border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
            top: -15px;
            transform-origin: bottom center;
            box-shadow: 0 0 15px rgba(255, 234, 0, 0.4);
        }

        /* Tallo de la flor */
        .stem {
            width: 10px;
            height: 180px;
            background: linear-gradient(to right, #2d6a4f, #1b4332);
            margin-top: -10px;
            border-radius: 5px;
            z-index: 1;
        }

        /* Mensaje especial personalizado */
        .message {
            margin-top: 25px;
            color: #ffd000;
            font-size: 1.6rem;
            font-weight: bold;
            text-align: center;
            text-shadow: 0 0 10px rgba(255, 208, 0, 0.6);
            letter-spacing: 1px;
            z-index: 10;
            padding: 0 20px;
        }
    </style>
</head>
<body>

    <!-- Capa del sobre interactivo -->
    <div class="envelope-wrapper" id="envelope-box">
        <div class="envelope" onclick="openLetter()">
            <div class="heart">🌻</div>
        </div>
        <div class="envelope-text">Wildanyelis, tienes una carta pendiente... Toca para abrir</div>
    </div>

    <!-- Contenedor del universo (Flor y nombre) -->
    <div class="flower-container" id="flower-content">
        <div class="center" id="flower-center"></div>
        <div class="stem"></div>
        
        <!-- Mensaje Personalizado -->
        <div class="message">¡Un universo de flores amarillas solo para ti, Wildanyelis! 🌻</div>
    </div>

    <script>
        // Función para activar la animación de apertura e iniciar la lluvia de pétalos
        function openLetter() {
            document.getElementById('envelope-box').classList.add('open');
            document.getElementById('flower-content').classList.add('show');
            createFallingPetals();
        }

        // Generador de pétalos automáticos en círculo para la flor central
        const center = document.getElementById('flower-center');
        const totalPetals = 12;

        for (let i = 0; i < totalPetals; i++) {
            const petal = document.createElement('div');
            petal.classList.add('petal');
            const angle = (360 / totalPetals) * i;
            petal.style.transform = `translateX(-50%) rotate(${angle}deg)`;
            petal.style.left = '50%';
            center.parentNode.insertBefore(petal, center);
        }

        // Generador de estrellas aleatorias
        const totalStars = 80;
        for (let i = 0; i < totalStars; i++) {
            const star = document.createElement('div');
            star.classList.add('star');
            const size = Math.random() * 3;
            star.style.width = `${size}px`;
            star.style.height = `${size}px`;
            star.style.left = `${Math.random() * 100}vw`;
            star.style.top = `${Math.random() * 100}vh`;
            star.style.animationDelay = `${Math.random() * 2}s`;
            document.body.appendChild(star);
        }

        // Generador de pétalos cayendo por el fondo (se activa al abrir la carta)
        function createFallingPetals() {
            const totalFallingPetals = 25;
            for (let i = 0; i < totalFallingPetals; i++) {
                const petal = document.createElement('div');
                petal.classList.add('falling-petal');
                
                // Dimensiones y posiciones aleatorias para naturalidad
                const width = 15 + Math.random() * 15;
                const height = 30 + Math.random() * 20;
                petal.style.width = `${width}px`;
                petal.style.height = `${height}px`;
                
                petal.style.left = `${Math.random() * 100}vw`;
                
                // Tiempos aleatorios de caída y retraso
                const duration = 4 + Math.random() * 5;
                const delay = Math.random() * 5;
                petal.style.animationDuration = `${duration}s`;
                petal.style.animationDelay = `${delay}s`;
                
                document.body.appendChild(petal);
            }
        }
    </script>
</body>
</html>
